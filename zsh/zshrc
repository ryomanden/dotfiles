# -----------------
# Zsh configuration
# -----------------

#
# History
#

# Remove older command from the history if a duplicate is to be added.
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS

#
# Input/output
#

# Set editor default keymap to emacs (`-e`) or vi (`-v`)
bindkey -e

# Remove path separator from WORDCHARS.
WORDCHARS=${WORDCHARS//[\/]}

# --------------------
# Module configuration
# --------------------

#
# zsh-autosuggestions
#

# Disable automatic widget re-binding on each precmd. This can be set when
# zsh-users/zsh-autosuggestions is the last module in your ~/.zimrc.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

#
# zsh-syntax-highlighting
#

# Set what highlighters will be used.
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# ------------------
# Initialize modules
# ------------------

ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
ZIM_CONFIG_FILE=${HOME}/dotfiles/zsh/zimrc

# Download zimfw plugin manager if missing.
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  if (( ${+commands[curl]} )); then
    curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  else
    mkdir -p ${ZIM_HOME} && wget -nv -O ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  fi
fi
# Install missing modules, and update ${ZIM_HOME}/init.zsh if missing or outdated.
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE} ]]; then
  source ${ZIM_HOME}/zimfw.zsh init
fi
# Initialize modules.
source ${ZIM_HOME}/init.zsh

# ------------------
# User configuration
# ------------------

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/ryo_mitsuda/.lmstudio/bin"

# history-substring-search のキーバインド（zimのモジュールと連携）
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# zsh-autocomplete を非同期ロード（プロンプト表示をブロックしない）
zsh-defer source /usr/local/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh

source ~/.safe-chain/scripts/init-posix.sh # Safe-chain Zsh initialization script

# starship（非同期プロンプト描画）
export STARSHIP_CONFIG=${HOME}/dotfiles/starship/starship.toml
export STARSHIP_SHELL="zsh"

zmodload zsh/parameter
zmodload zsh/datetime
zmodload zsh/mathfunc
setopt promptsubst

# starship 用の変数管理（starship init の precmd/preexec 相当）
STARSHIP_SESSION_KEY="$RANDOM$RANDOM$RANDOM$RANDOM$RANDOM"
STARSHIP_SESSION_KEY="${STARSHIP_SESSION_KEY}0000000000000000"
export STARSHIP_SESSION_KEY=${STARSHIP_SESSION_KEY:0:16}
VIRTUAL_ENV_DISABLE_PROMPT=1

__starship_get_time() {
  (( STARSHIP_CAPTURED_TIME = int(rint(EPOCHREALTIME * 1000)) ))
}

_starship_precmd() {
  STARSHIP_CMD_STATUS=$? STARSHIP_PIPE_STATUS=(${pipestatus[@]})
  if (( ${+STARSHIP_START_TIME} )); then
    __starship_get_time && STARSHIP_DURATION=$(( STARSHIP_CAPTURED_TIME - STARSHIP_START_TIME ))
    unset STARSHIP_START_TIME
  else
    unset STARSHIP_DURATION STARSHIP_CMD_STATUS STARSHIP_PIPE_STATUS
  fi
  STARSHIP_JOBS_COUNT="${#jobstates[*]}"
}

_starship_preexec() {
  __starship_get_time && STARSHIP_START_TIME=$STARSHIP_CAPTURED_TIME
}

# 軽量な仮プロンプト（即座に表示される）
PROMPT='%F{cyan}%1~%f %(?.%F{green}.%F{red})❯%f '
RPROMPT=''

# 非同期プロンプト描画
typeset -g _async_prompt_fd=
typeset -g _async_prompt_pid=

_async_prompt_callback() {
  local fd=$1
  if [[ -n "$fd" ]]; then
    local result
    result=$(<&$fd)
    zle -F "$fd" 2>/dev/null
    exec {fd}<&-
    _async_prompt_fd=
    _async_prompt_pid=
    if [[ -n "$result" ]]; then
      PROMPT="${result}"
      zle reset-prompt
    fi
  fi
}
zle -N _async_prompt_callback

_async_prompt_line_init() {
  # 既存の非同期プロセスをクリーンアップ
  if [[ -n "$_async_prompt_fd" ]]; then
    zle -F "$_async_prompt_fd" 2>/dev/null
    exec {_async_prompt_fd}<&- 2>/dev/null
    _async_prompt_fd=
  fi
  if [[ -n "$_async_prompt_pid" ]] && kill -0 "$_async_prompt_pid" 2>/dev/null; then
    kill "$_async_prompt_pid" 2>/dev/null
    _async_prompt_pid=
  fi

  # starship prompt を非同期で実行
  exec {_async_prompt_fd}< <(
    /usr/local/bin/starship prompt \
      --terminal-width="$COLUMNS" \
      --keymap="${KEYMAP:-}" \
      --status="${STARSHIP_CMD_STATUS:-}" \
      --pipestatus="${STARSHIP_PIPE_STATUS[*]:-}" \
      --cmd-duration="${STARSHIP_DURATION:-}" \
      --jobs="$STARSHIP_JOBS_COUNT"
  )
  _async_prompt_pid=$!

  # fd が読み取り可能になったらコールバック
  zle -F "$_async_prompt_fd" _async_prompt_callback
}

# starship の zle-line-init を考慮した統合
if (( ${+widgets[zle-line-init]} )); then
  _orig_zle_line_init=${widgets[zle-line-init]#user:}
  _async_prompt_line_init_wrapper() {
    $_orig_zle_line_init "$@"
    _async_prompt_line_init
  }
  zle -N zle-line-init _async_prompt_line_init_wrapper
else
  zle -N zle-line-init _async_prompt_line_init
fi

add-zsh-hook precmd _starship_precmd
add-zsh-hook preexec _starship_preexec

. "$HOME/.local/bin/env"
